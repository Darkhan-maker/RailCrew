generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  DRIVER
  ASSISTANT
}

enum TripType {
  FREIGHT
  PASSENGER
  SHUNTING
  DEAD_RUN
}

enum AppearanceType {
  HOME
  TURNAROUND
}

enum TripStatus {
  DRAFT
  CONFIRMED
}

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  passwordHash       String
  role               UserRole @default(DRIVER)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  telegramId         String?  @unique
  telegramLinkCode   String?

  profile     Profile?
  trips       Trip[]
  salaryRules SalaryRule[]

  @@map("users")
}

model Profile {
  id          String   @id @default(uuid())
  userId      String   @unique
  firstName   String
  lastName    String
  employeeId  String?
  depot       String?
  tariffGrade Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Trip {
  id              String     @id @default(uuid())
  userId          String
  routeFrom       String
  routeTo         String
  date            String     // YYYY-MM-DD
  endDate         String?    // YYYY-MM-DD (overnight trips)
  startTime       String     // HH:mm
  endTime         String     // HH:mm
  durationMinutes Int
  tripType        TripType
  status          TripStatus @default(CONFIRMED)
  notes           String?
  localId         String?    // клиентский UUID для offline-first
  syncedAt        DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Work-cycle fields
  trainNumber       String?
  trainWeight       Float?
  axleCount         Int?
  conditionalLength Int?
  locoModel      String?
  locoNumber     String?
  appearanceDate String?    // YYYY-MM-DD
  appearanceTime String?    // HH:mm
  handoverDate   String?    // YYYY-MM-DD
  handoverTime   String?    // HH:mm
  sectionCount   Int?
  isPassenger    Boolean?

  // Energy meter fields
  energy1Start       Float?
  energy1End         Float?
  energy1Consumption Float?
  energy2Start       Float?
  energy2End         Float?
  energy2Consumption Float?
  energy3Start       Float?
  energy3End         Float?
  energy3Consumption Float?

  // New fields
  appearanceType          AppearanceType?
  lunchBreakMinutes       Int?
  recuperation1Accepted   Float?
  recuperation1Delivered  Float?
  recuperation2Accepted   Float?
  recuperation2Delivered  Float?
  recuperation3Accepted   Float?
  recuperation3Delivered  Float?
  checkpointOut           Float?
  checkpointIn            Float?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("trips")
}

model SalaryRule {
  id                     String    @id @default(uuid())
  userId                 String
  name                   String
  ratePerHour            Float
  nightCoefficient       Float     @default(1.2)
  overtimeCoefficient    Float     @default(1.5)
  overtimeThresholdHours Float     @default(8)
  tripBonus              Float     @default(0)
  effectiveFrom          String    // YYYY-MM-DD
  effectiveTo            String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Extended salary fields
  harmfulnessPercent    Float?    @default(0)
  classPercent          Float?    @default(0)
  zonalPercent          Float?    @default(0)
  regionalCoefficient   Float?    @default(1)
  unionPercent          Float?    @default(1)
  taxPercent            Float?    @default(13)
  holidayCoefficient    Float?    @default(2)
  tripBonusPerHour      Float?    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("salary_rules")
}
