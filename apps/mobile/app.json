{
  "expo": {
    "name": "RailCrew",
    "slug": "railcrew-mvp",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "kz.railcrew.mvp",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Требуется для голосового ввода данных о поездке",
        "NSSpeechRecognitionUsageDescription": "Требуется для распознавания голосового ввода"
      }
    },
    "android": {
      "package": "kz.railcrew.mvp",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "permissions": ["android.permission.RECORD_AUDIO"]
    },
    "plugins": ["expo-router"],
    "scheme": "railcrew"
  }
}
