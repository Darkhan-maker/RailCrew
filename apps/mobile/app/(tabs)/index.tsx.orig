import { useEffect, useMemo, useState } from 'react';
import { View, Text, StyleSheet, TouchableOpacity, ScrollView } from 'react-native';
import { format, startOfWeek, endOfWeek, startOfMonth, endOfMonth, getDaysInMonth } from 'date-fns';
import { useTripsStore } from '@/store/trips.store';
import {
  localSalaryStorage, LocalSalaryRule,
  localSettingsStorage, LocalSettings,
} from '@/services/storage.service';
import { TripTypeLabelMap } from '@railcrew/contracts';
import { formatDuration } from '@/utils/date';

type PeriodFilter = 'DAY' | 'WEEK' | 'MONTH';

const PERIODS: { label: string; value: PeriodFilter }[] = [
  { label: 'День', value: 'DAY' },
  { label: 'Неделя', value: 'WEEK' },
  { label: 'Месяц', value: 'MONTH' },
];

function getPeriodBounds(period: PeriodFilter): { from: string; to: string } {
  const now = new Date();
  const fmt = (d: Date) => format(d, 'yyyy-MM-dd');
  switch (period) {
    case 'DAY':
      return { from: fmt(now), to: fmt(now) };
    case 'WEEK':
      return {
        from: fmt(startOfWeek(now, { weekStartsOn: 1 })),
        to: fmt(endOfWeek(now, { weekStartsOn: 1 })),
      };
    case 'MONTH':
      return { from: fmt(startOfMonth(now)), to: fmt(endOfMonth(now)) };
  }
}

/** Парсинг ночных минут из notes поездки */
function parseNightMinutesFromNotes(notes: string | null | undefined): number {
  if (!notes) return 0;
  const match = notes.match(/Ночных:\s*(\d+)\s*ч(?:\s*(\d+)\s*мин)?/);
  if (!match) return 0;
  return (parseInt(match[1], 10) || 0) * 60 + (parseInt(match[2], 10) || 0);
}

/** Норма часов на сегодня (пропорция от месячной нормы) */
function normToday(monthlyNorm: number): number {
  const now = new Date();
  const dayOfMonth = now.getDate();
  const daysInMonth = getDaysInMonth(now);
  return Math.round((monthlyNorm / daysInMonth) * dayOfMonth * 10) / 10;
}

export default function DashboardScreen() {
  const { trips, loadLocal } = useTripsStore();
  const [period, setPeriod] = useState<PeriodFilter>('MONTH');
  const [salaryRule, setSalaryRule] = useState<LocalSalaryRule | null>(null);
  const [settings, setSettings] = useState<LocalSettings | null>(null);

  useEffect(() => {
    loadLocal();
    localSalaryStorage.get().then(setSalaryRule);
    localSettingsStorage.get().then(setSettings);
  }, []);

  const filtered = useMemo(() => {
    const { from, to } = getPeriodBounds(period);
    return trips.filter((t) => t.date >= from && t.date <= to);
  }, [trips, period]);

  const totalMinutes = useMemo(
    () => filtered.reduce((sum, t) => sum + (t.durationMinutes ?? 0), 0),
    [filtered],
  );

  const totalHours = Math.floor(totalMinutes / 60);

  const totalNightMinutes = useMemo(
    () => filtered.reduce((sum, t) => sum + parseNightMinutesFromNotes(t.notes), 0),
    [filtered],
  );

  const routeStats = useMemo(() => {
    const map = new Map<string, { routeFrom: string; routeTo: string; count: number; totalMinutes: number }>();
    for (const t of filtered) {
      const key = `${t.routeFrom}__${t.routeTo}`;
      const existing = map.get(key);
      if (existing) {
        existing.count += 1;
        existing.totalMinutes += t.durationMinutes ?? 0;
      } else {
        map.set(key, {
          routeFrom: t.routeFrom,
          routeTo: t.routeTo,
          count: 1,
          totalMinutes: t.durationMinutes ?? 0,
        });
      }
    }
    return Array.from(map.values()).sort((a, b) => b.count - a.count);
  }, [filtered]);

  const typeStats = useMemo(() => {
    const map = new Map<string, number>();
    for (const t of filtered) {
      map.set(t.tripType, (map.get(t.tripType) ?? 0) + 1);
    }
    return Array.from(map.entries()).sort((a, b) => b[1] - a[1]);
  }, [filtered]);

  return (
    <ScrollView style={s.screen} contentContainerStyle={{ paddingBottom: 40 }}>
      <Text style={s.header}>Сводка</Text>

      {/* Период */}
      <View style={s.periodRow}>
        {PERIODS.map((p) => (
          <TouchableOpacity
            key={p.value}
            style={[s.periodBtn, period === p.value && s.periodBtnActive]}
            onPress={() => setPeriod(p.value)}
            activeOpacity={0.75}
          >
            <Text style={[s.periodBtnText, period === p.value && s.periodBtnTextActive]}>
              {p.label}
            </Text>
          </TouchableOpacity>
        ))}
      </View>

      {/* ─── Норма часов ──────────────────────────────────────────────────── */}
      {settings && settings.monthlyHoursNorm > 0 && period === 'MONTH' && (
        <View style={s.normCard}>
          <View style={s.normRow}>
            <Text style={s.normLabel}>Норма на месяц</Text>
            <Text style={s.normValue}>{settings.monthlyHoursNorm} ч</Text>
          </View>
          <View style={s.normRow}>
            <Text style={s.normLabel}>Норма на сегодня</Text>
            <Text style={s.normValue}>{normToday(settings.monthlyHoursNorm)} ч</Text>
          </View>
          <View style={s.normRow}>
            <Text style={s.normLabel}>Отработано</Text>
            <Text style={[
              s.normValue,
              totalHours >= normToday(settings.monthlyHoursNorm) ? { color: '#34d399' } : { color: '#f59e0b' },
            ]}>
              {totalHours} ч
            </Text>
          </View>

          {/* Прогресс-бар */}
          <View style={s.progressBg}>
            <View
              style={[
                s.progressFill,
                { width: `${Math.min(100, (totalHours / settings.monthlyHoursNorm) * 100)}%` },
              ]}
            />
          </View>
          <Text style={s.progressText}>
            {Math.round((totalHours / settings.monthlyHoursNorm) * 100)}% от нормы
          </Text>
        </View>
      )}

      {filtered.length === 0 ? (
        <Text style={s.empty}>Нет поездок за выбранный период</Text>
      ) : (
        <>
          {/* Главные показатели */}
          <View style={s.cardRow}>
            <StatCard label="Поездок" value={String(filtered.length)} />
            <StatCard label="Часов" value={String(totalHours)} />
          </View>
          <View style={s.cardRow}>
            <StatCard label="Всего времени" value={formatDuration(totalMinutes)} wide />
          </View>

          {/* Ночные часы */}
          {settings?.trackNightHours && totalNightMinutes > 0 && (
            <View style={s.nightCard}>
              <Text style={s.nightIcon}>🌙</Text>
              <View>
                <Text style={s.nightLabel}>Ночных часов</Text>
                <Text style={s.nightValue}>{formatDuration(totalNightMinutes)}</Text>
              </View>
            </View>
          )}

          {/* Зарплата */}
          <SalaryCard
            rule={salaryRule}
            totalMinutes={totalMinutes}
            nightMinutes={totalNightMinutes}
            tripCount={filtered.length}
            monthlyNorm={settings?.monthlyHoursNorm ?? 176}
          />

          {/* Типы поездок */}
          {typeStats.length > 0 && (
            <View style={s.card}>
              <Text style={s.cardTitle}>По типам</Text>
              {typeStats.map(([type, count]) => (
                <View key={type} style={s.statRow}>
                  <Text style={s.statRowLabel}>{TripTypeLabelMap[type as keyof typeof TripTypeLabelMap]}</Text>
                  <Text style={s.statRowValue}>{count}</Text>
                </View>
              ))}
            </View>
          )}

          {/* Маршруты */}
          {routeStats.length > 0 && (
            <View style={s.card}>
              <Text style={s.cardTitle}>Маршруты</Text>
              {routeStats.map((r, i) => (
                <View key={i} style={s.routeRow}>
                  <Text style={s.routeText} numberOfLines={1}>
                    {r.routeFrom} — {r.routeTo}
                  </Text>
                  <Text style={s.routeMeta}>
                    {r.count} {pluralTrips(r.count)} · {formatDuration(r.totalMinutes)}
                  </Text>
                </View>
              ))}
            </View>
          )}
        </>
      )}
    </ScrollView>
  );
}

function SalaryCard({
  rule, totalMinutes, nightMinutes, tripCount, monthlyNorm,
}: {
  rule: LocalSalaryRule | null;
  totalMinutes: number;
  nightMinutes: number;
  tripCount: number;
  monthlyNorm: number;
}) {
  if (!rule || rule.ratePerHour === 0) {
    return (
      <View style={s.card}>
        <Text style={s.cardTitle}>Ориентировочная зарплата</Text>
        <Text style={s.salaryPlaceholder}>
          Задайте ставку за час в разделе «Настройки»
        </Text>
      </View>
    );
  }

  const totalHours = totalMinutes / 60;
  const nightHours = nightMinutes / 60;
  const regularHours = totalHours - nightHours;

  // Сверхурочные
  const threshold = rule.monthlyHoursThreshold || monthlyNorm;
  const overtimeHours = Math.max(0, totalHours - threshold);
  const normalHours = totalHours - overtimeHours;

  // Расчёт
  const basePay = Math.round(
    (normalHours - nightHours) * rule.ratePerHour +
    nightHours * rule.ratePerHour * (rule.nightCoefficient || 1.4) +
    overtimeHours * rule.ratePerHour * (rule.overtimeCoefficient || 1.5),
  );
  const bonuses = Math.round(tripCount * rule.tripBonus);
  const total = basePay + bonuses;

  return (
    <View style={s.card}>
      <Text style={s.cardTitle}>Ориентировочная зарплата</Text>

      <View style={s.salaryRow}>
        <Text style={s.salaryLabel}>Обычные часы ({Math.round(normalHours - nightHours)} ч)</Text>
        <Text style={s.salaryValue}>
          {Math.round((normalHours - nightHours) * rule.ratePerHour).toLocaleString()} ₸
        </Text>
      </View>

      {nightHours > 0 && (
        <View style={s.salaryRow}>
          <Text style={s.salaryLabel}>Ночные ({Math.round(nightHours)} ч × {rule.nightCoefficient || 1.4})</Text>
          <Text style={s.salaryValue}>
            {Math.round(nightHours * rule.ratePerHour * (rule.nightCoefficient || 1.4)).toLocaleString()} ₸
          </Text>
        </View>
      )}

      {overtimeHours > 0 && (
        <View style={s.salaryRow}>
          <Text style={s.salaryLabel}>Сверхурочные ({Math.round(overtimeHours)} ч × {rule.overtimeCoefficient || 1.5})</Text>
          <Text style={s.salaryValue}>
            {Math.round(overtimeHours * rule.ratePerHour * (rule.overtimeCoefficient || 1.5)).toLocaleString()} ₸
          </Text>
        </View>
      )}

      {bonuses > 0 && (
        <View style={s.salaryRow}>
          <Text style={s.salaryLabel}>Бонусы за поездки</Text>
          <Text style={s.salaryValue}>{bonuses.toLocaleString()} ₸</Text>
        </View>
      )}

      <View style={s.salaryDivider} />
      <View style={s.salaryRow}>
        <Text style={[s.salaryLabel, { color: '#f1f5f9', fontWeight: '600' }]}>Итого ≈</Text>
        <Text style={[s.salaryValue, { color: '#3b82f6', fontWeight: '700', fontSize: 18 }]}>
          {total.toLocaleString()} ₸
        </Text>
      </View>
    </View>
  );
}

function StatCard({ label, value, wide }: { label: string; value: string; wide?: boolean }) {
  return (
    <View style={[s.statCard, wide && { flex: 1 }]}>
      <Text style={s.statValue}>{value}</Text>
      <Text style={s.statLabel}>{label}</Text>
    </View>
  );
}

function pluralTrips(n: number): string {
  const mod10 = n % 10;
  const mod100 = n % 100;
  if (mod10 === 1 && mod100 !== 11) return 'поездка';
  if (mod10 >= 2 && mod10 <= 4 && (mod100 < 10 || mod100 >= 20)) return 'поездки';
  return 'поездок';
}

const s = StyleSheet.create({
  screen: { flex: 1, backgroundColor: '#0f172a', padding: 16 },
  header: {
    color: '#f1f5f9', fontSize: 24, fontWeight: 'bold',
    marginTop: 48, marginBottom: 12,
  },

  // Период
  periodRow: { flexDirection: 'row', gap: 8, marginBottom: 20 },
  periodBtn: {
    paddingHorizontal: 16, paddingVertical: 8, borderRadius: 20,
    backgroundColor: '#1e293b', borderWidth: 1, borderColor: '#334155',
  },
  periodBtnActive: { backgroundColor: '#3b82f6', borderColor: '#3b82f6' },
  periodBtnText: { color: '#64748b', fontSize: 14 },
  periodBtnTextActive: { color: '#fff', fontWeight: '600' },

  // Норма часов
  normCard: {
    backgroundColor: '#1e293b', borderRadius: 14, padding: 16, marginBottom: 10,
    borderLeftWidth: 3, borderLeftColor: '#3b82f6',
  },
  normRow: { flexDirection: 'row', justifyContent: 'space-between', marginBottom: 4 },
  normLabel: { color: '#94a3b8', fontSize: 14 },
  normValue: { color: '#f1f5f9', fontSize: 14, fontWeight: '600' },
  progressBg: {
    height: 6, backgroundColor: '#0f172a', borderRadius: 3, marginTop: 10, overflow: 'hidden',
  },
  progressFill: { height: '100%', backgroundColor: '#3b82f6', borderRadius: 3 },
  progressText: { color: '#64748b', fontSize: 12, marginTop: 4, textAlign: 'right' },

  // Ночные часы
  nightCard: {
    backgroundColor: '#1e293b', borderRadius: 14, padding: 16, marginBottom: 10,
    flexDirection: 'row', alignItems: 'center', gap: 12,
    borderLeftWidth: 3, borderLeftColor: '#a78bfa',
  },
  nightIcon: { fontSize: 24 },
  nightLabel: { color: '#94a3b8', fontSize: 13 },
  nightValue: { color: '#a78bfa', fontSize: 16, fontWeight: '600' },

  // Карточки
  cardRow: { flexDirection: 'row', gap: 10, marginBottom: 10 },
  statCard: {
    flex: 1, backgroundColor: '#1e293b', borderRadius: 14, padding: 16, alignItems: 'center',
  },
  statValue: { color: '#3b82f6', fontSize: 28, fontWeight: 'bold' },
  statLabel: { color: '#64748b', fontSize: 13, marginTop: 4 },

  card: { backgroundColor: '#1e293b', borderRadius: 14, padding: 16, marginBottom: 10 },
  cardTitle: { color: '#94a3b8', fontSize: 13, fontWeight: '600', marginBottom: 12 },

  // Зарплата
  salaryPlaceholder: { color: '#475569', fontSize: 14 },
  salaryRow: { flexDirection: 'row', justifyContent: 'space-between', marginBottom: 6 },
  salaryLabel: { color: '#64748b', fontSize: 14 },
  salaryValue: { color: '#f1f5f9', fontSize: 14 },
  salaryDivider: { height: 1, backgroundColor: '#334155', marginVertical: 8 },

  // По типам
  statRow: { flexDirection: 'row', justifyContent: 'space-between', marginBottom: 6 },
  statRowLabel: { color: '#94a3b8', fontSize: 14 },
  statRowValue: { color: '#f1f5f9', fontSize: 14, fontWeight: '600' },

  // Маршруты
  routeRow: { marginBottom: 10 },
  routeText: { color: '#f1f5f9', fontSize: 14 },
  routeMeta: { color: '#64748b', fontSize: 12, marginTop: 2 },

  empty: { color: '#64748b', textAlign: 'center', marginTop: 60, fontSize: 16 },
});
