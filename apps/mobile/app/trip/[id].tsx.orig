import { useEffect, useState } from 'react';
import {
  View, Text, TextInput, TouchableOpacity, StyleSheet,
  ScrollView, Alert, ActivityIndicator, Platform, Modal,
} from 'react-native';
import DateTimePicker, { DateTimePickerEvent } from '@react-native-community/datetimepicker';
import { format } from 'date-fns';
import { router, useLocalSearchParams } from 'expo-router';
import { useTripsStore } from '@/store/trips.store';
import { tripsApi } from '@/services/api.service';
import { Trip, TripType, TripTypeLabelMap, UpdateTripDtoSchema } from '@railcrew/contracts';
import { formatDateRu, formatDuration } from '@/utils/date';

const TYPES: TripType[] = ['FREIGHT', 'PASSENGER', 'SHUNTING', 'DEAD_RUN'];

type PickerMode = 'date' | 'start' | 'end' | null;

function calcDuration(start: string, end: string): number | null {
  const [sh, sm] = start.split(':').map(Number);
  const [eh, em] = end.split(':').map(Number);
  const startMin = sh * 60 + sm;
  const endMin = eh * 60 + em;
  if (endMin <= startMin) return null;
  return endMin - startMin;
}

export default function TripDetailScreen() {
  const { id } = useLocalSearchParams<{ id: string }>();
  const { trips, updateTrip } = useTripsStore();
  const [trip, setTrip] = useState<Trip | null>(null);
  const [editing, setEditing] = useState(false);
  const [saving, setSaving] = useState(false);
  const [draft, setDraft] = useState<Partial<Trip>>({});
  const [pickerMode, setPickerMode] = useState<PickerMode>(null);
  const [timeError, setTimeError] = useState('');

  useEffect(() => {
    // Сначала ищем в локальном store
    const local = trips.find((t) => t.id === id || t.localId === id);
    if (local) {
      setTrip(local);
      setDraft(local);
      return;
    }
    // Fallback — API
    tripsApi.get(id).then((t) => {
      setTrip(t);
      setDraft(t);
    }).catch(() => {
      Alert.alert('Ошибка', 'Поездка не найдена');
      router.back();
    });
  }, [id, trips]);

  function setField(key: keyof Trip, value: string | number | TripType) {
    setDraft((d) => ({ ...d, [key]: value }));
  }

  function handleDateChange(_: DateTimePickerEvent, selected?: Date) {
    if (Platform.OS === 'android') setPickerMode(null);
    if (!selected) return;
    setField('date', format(selected, 'yyyy-MM-dd'));
  }

  function handleTimeChange(_: DateTimePickerEvent, selected?: Date) {
    const mode = pickerMode;
    if (Platform.OS === 'android') setPickerMode(null);
    if (!selected || !mode) return;

    const timeStr = format(selected, 'HH:mm');

    setDraft((d) => {
      const next = mode === 'start'
        ? { ...d, startTime: timeStr }
        : { ...d, endTime: timeStr };

      const start = next.startTime;
      const end = next.endTime;

      if (start && end) {
        const dur = calcDuration(start, end);
        if (dur === null) {
          setTimeError('Время окончания раньше времени начала');
          return { ...next, durationMinutes: d.durationMinutes };
        }
        setTimeError('');
        return { ...next, durationMinutes: dur };
      }
      setTimeError('');
      return next;
    });
  }

  function pickerDate(): Date {
    if (pickerMode === 'date' && draft.date) {
      const [y, m, d] = draft.date.split('-').map(Number);
      return new Date(y, m - 1, d);
    }
    if (pickerMode === 'start' && draft.startTime) {
      const [h, m] = draft.startTime.split(':').map(Number);
      const d = new Date(); d.setHours(h, m, 0, 0); return d;
    }
    if (pickerMode === 'end' && draft.endTime) {
      const [h, m] = draft.endTime.split(':').map(Number);
      const d = new Date(); d.setHours(h, m, 0, 0); return d;
    }
    return new Date();
  }

  function handleCancelEdit() {
    setEditing(false);
    setDraft(trip ?? {});
    setTimeError('');
    setPickerMode(null);
  }

  async function handleSave() {
    if (timeError) {
      Alert.alert('Ошибка времени', timeError);
      return;
    }
    const result = UpdateTripDtoSchema.safeParse(draft);
    if (!result.success) {
      Alert.alert('Ошибка', 'Проверьте данные');
      return;
    }
    setSaving(true);
    try {
      await updateTrip(id, result.data);
      setTrip((prev) => ({ ...prev!, ...result.data }));
      setEditing(false);
    } catch {
      Alert.alert('Ошибка', 'Не удалось сохранить');
    } finally {
      setSaving(false);
    }
  }

  const pickerNode = pickerMode ? (
    <DateTimePicker
      value={pickerDate()}
      mode={pickerMode === 'date' ? 'date' : 'time'}
      is24Hour
      display={Platform.OS === 'ios' ? 'spinner' : 'default'}
      onChange={pickerMode === 'date' ? handleDateChange : handleTimeChange}
    />
  ) : null;

  if (!trip) {
    return <ActivityIndicator color="#3b82f6" style={{ flex: 1, backgroundColor: '#0f172a' }} />;
  }

  return (
    <ScrollView style={s.screen} keyboardShouldPersistTaps="handled">
      <TouchableOpacity onPress={() => router.back()} style={s.back}>
        <Text style={s.backText}>← Назад</Text>
      </TouchableOpacity>

      <View style={s.titleRow}>
        <Text style={s.title} numberOfLines={2}>
          {trip.routeFrom} — {trip.routeTo}
        </Text>
        <TouchableOpacity onPress={editing ? handleCancelEdit : () => setEditing(true)}>
          <Text style={s.editBtn}>{editing ? 'Отмена' : 'Изменить'}</Text>
        </TouchableOpacity>
      </View>

      {!editing ? (
        /* ── Режим просмотра ── */
        <>
          <View style={s.card}>
            <InfoRow label="Дата" value={formatDateRu(trip.date)} />
            <InfoRow label="Время" value={`${trip.startTime} – ${trip.endTime}`} />
            <InfoRow label="Длительность" value={formatDuration(trip.durationMinutes)} />
            <InfoRow label="Тип" value={TripTypeLabelMap[trip.tripType]} />
            {trip.notes ? <InfoRow label="Примечание" value={trip.notes} /> : null}
            <InfoRow label="Статус" value={trip.syncedAt ? 'Синхронизировано' : 'Локально'} />
          </View>
          <TouchableOpacity
            style={s.duplicateBtn}
            onPress={() =>
              router.push({
                pathname: '/(tabs)/add',
                params: {
                  routeFrom: trip.routeFrom,
                  routeTo: trip.routeTo,
                  tripType: trip.tripType,
                  notes: trip.notes ?? '',
                },
              })
            }
            activeOpacity={0.75}
          >
            <Text style={s.duplicateBtnText}>Дублировать поездку</Text>
          </TouchableOpacity>
        </>
      ) : (
        /* ── Режим редактирования ── */
        <View style={s.card}>

          {/* Маршрут вертикальный */}
          <Text style={s.label}>Откуда</Text>
          <TextInput
            style={s.input}
            value={draft.routeFrom ?? ''}
            onChangeText={(v) => setField('routeFrom', v)}
            placeholderTextColor="#475569"
            placeholder="Откуда"
          />
          <View style={s.routeDivider}>
            <View style={s.routeLine} />
            <Text style={s.routeArrow}>↓</Text>
            <View style={s.routeLine} />
          </View>
          <Text style={s.label}>Куда</Text>
          <TextInput
            style={s.input}
            value={draft.routeTo ?? ''}
            onChangeText={(v) => setField('routeTo', v)}
            placeholderTextColor="#475569"
            placeholder="Куда"
          />

          {/* Дата */}
          <Text style={s.label}>Дата</Text>
          <TouchableOpacity
            style={s.pickerField}
            onPress={() => setPickerMode('date')}
            activeOpacity={0.7}
          >
            <Text style={draft.date ? s.pickerValue : s.pickerPlaceholder}>
              {draft.date ?? 'Выбрать дату'}
            </Text>
            <Text style={s.pickerIcon}>📅</Text>
          </TouchableOpacity>

          {/* Время */}
          <View style={s.timeRow}>
            <View style={s.timeCol}>
              <Text style={s.label}>Начало</Text>
              <TouchableOpacity
                style={s.pickerField}
                onPress={() => setPickerMode('start')}
                activeOpacity={0.7}
              >
                <Text style={draft.startTime ? s.pickerValue : s.pickerPlaceholder}>
                  {draft.startTime ?? '--:--'}
                </Text>
                <Text style={s.pickerIcon}>🕐</Text>
              </TouchableOpacity>
            </View>
            <View style={s.timeSep} />
            <View style={s.timeCol}>
              <Text style={s.label}>Окончание</Text>
              <TouchableOpacity
                style={s.pickerField}
                onPress={() => setPickerMode('end')}
                activeOpacity={0.7}
              >
                <Text style={draft.endTime ? s.pickerValue : s.pickerPlaceholder}>
                  {draft.endTime ?? '--:--'}
                </Text>
                <Text style={s.pickerIcon}>🕐</Text>
              </TouchableOpacity>
            </View>
          </View>

          {timeError ? (
            <Text style={s.timeError}>{timeError}</Text>
          ) : draft.durationMinutes ? (
            <Text style={s.duration}>Длительность: {formatDuration(draft.durationMinutes)}</Text>
          ) : null}

          {/* Тип поездки */}
          <Text style={s.label}>Тип поездки</Text>
          <View style={s.chipRow}>
            {TYPES.map((t) => (
              <TouchableOpacity
                key={t}
                style={[s.chip, draft.tripType === t && s.chipActive]}
                onPress={() => setField('tripType', t)}
              >
                <Text style={[s.chipText, draft.tripType === t && s.chipTextActive]}>
                  {TripTypeLabelMap[t]}
                </Text>
              </TouchableOpacity>
            ))}
          </View>

          {/* Примечание */}
          <Text style={s.label}>Примечание</Text>
          <TextInput
            style={s.input}
            value={draft.notes ?? ''}
            onChangeText={(v) => setField('notes', v)}
            placeholderTextColor="#475569"
            placeholder="Необязательно"
          />

          <TouchableOpacity style={s.btn} onPress={handleSave} disabled={saving}>
            {saving ? <ActivityIndicator color="#fff" /> : <Text style={s.btnText}>Сохранить</Text>}
          </TouchableOpacity>
        </View>
      )}

      {/* iOS bottom sheet */}
      {Platform.OS === 'ios' && pickerMode ? (
        <Modal transparent animationType="slide" visible>
          <View style={s.iosOverlay}>
            <View style={s.iosSheet}>
              <View style={s.iosSheetHeader}>
                <Text style={s.iosSheetTitle}>
                  {pickerMode === 'date' ? 'Выберите дату' : pickerMode === 'start' ? 'Время начала' : 'Время окончания'}
                </Text>
                <TouchableOpacity onPress={() => setPickerMode(null)}>
                  <Text style={s.iosSheetDone}>Готово</Text>
                </TouchableOpacity>
              </View>
              {pickerNode}
            </View>
          </View>
        </Modal>
      ) : (
        pickerNode
      )}
    </ScrollView>
  );
}

function InfoRow({ label, value }: { label: string; value: string }) {
  return (
    <View style={{ marginBottom: 12 }}>
      <Text style={{ color: '#64748b', fontSize: 12 }}>{label}</Text>
      <Text style={{ color: '#f1f5f9', fontSize: 15, marginTop: 2 }}>{value}</Text>
    </View>
  );
}

const s = StyleSheet.create({
  screen: { flex: 1, backgroundColor: '#0f172a', padding: 16 },
  back: { marginTop: 48, marginBottom: 12 },
  backText: { color: '#3b82f6', fontSize: 15 },
  titleRow: {
    flexDirection: 'row', justifyContent: 'space-between',
    alignItems: 'flex-start', marginBottom: 16, gap: 12,
  },
  title: { color: '#f1f5f9', fontSize: 20, fontWeight: 'bold', flex: 1 },
  editBtn: { color: '#3b82f6', fontSize: 15 },

  card: { backgroundColor: '#1e293b', borderRadius: 14, padding: 16, marginBottom: 12 },
  label: { color: '#94a3b8', fontSize: 13, marginBottom: 4, marginTop: 8 },
  input: {
    backgroundColor: '#0f172a', color: '#f1f5f9', borderRadius: 10,
    padding: 12, fontSize: 15, marginBottom: 4,
  },

  // Маршрут
  routeDivider: { flexDirection: 'row', alignItems: 'center', marginVertical: 4 },
  routeLine: { flex: 1, height: 1, backgroundColor: '#334155' },
  routeArrow: { color: '#475569', fontSize: 16, marginHorizontal: 8 },

  // Picker fields
  pickerField: {
    backgroundColor: '#0f172a', borderRadius: 10, padding: 12,
    flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between',
    marginBottom: 4,
  },
  pickerValue: { color: '#f1f5f9', fontSize: 15 },
  pickerPlaceholder: { color: '#475569', fontSize: 15 },
  pickerIcon: { fontSize: 16 },

  // Время
  timeRow: { flexDirection: 'row', alignItems: 'flex-start' },
  timeCol: { flex: 1 },
  timeSep: { width: 12 },
  timeError: { color: '#ef4444', fontSize: 13, marginTop: 6, marginBottom: 4 },
  duration: { color: '#34d399', fontSize: 13, marginTop: 6, marginBottom: 4 },

  // Chips
  chipRow: { flexDirection: 'row', flexWrap: 'wrap', gap: 8, marginBottom: 4 },
  chip: {
    paddingHorizontal: 12, paddingVertical: 6, borderRadius: 20,
    backgroundColor: '#0f172a', borderWidth: 1, borderColor: '#334155',
  },
  chipActive: { backgroundColor: '#3b82f6', borderColor: '#3b82f6' },
  chipText: { color: '#64748b', fontSize: 13 },
  chipTextActive: { color: '#fff', fontWeight: '600' },

  btn: {
    backgroundColor: '#3b82f6', borderRadius: 10, padding: 14,
    alignItems: 'center', marginTop: 12,
  },
  btnText: { color: '#fff', fontSize: 15, fontWeight: '600' },
  duplicateBtn: {
    borderWidth: 1, borderColor: '#334155', borderRadius: 12, padding: 14,
    alignItems: 'center', marginBottom: 40,
  },
  duplicateBtnText: { color: '#94a3b8', fontSize: 15, fontWeight: '600' },

  // iOS bottom sheet
  iosOverlay: { flex: 1, justifyContent: 'flex-end', backgroundColor: 'rgba(0,0,0,0.5)' },
  iosSheet: {
    backgroundColor: '#1e293b', borderTopLeftRadius: 20, borderTopRightRadius: 20,
    paddingBottom: 32,
  },
  iosSheetHeader: {
    flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center',
    padding: 16, borderBottomWidth: 1, borderBottomColor: '#334155',
  },
  iosSheetTitle: { color: '#f1f5f9', fontSize: 16, fontWeight: '600' },
  iosSheetDone: { color: '#3b82f6', fontSize: 16, fontWeight: '600' },
});
